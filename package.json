{
  "name": "voice-nexus",
  "version": "1.0.0",
  "description": "Voice Nexus — UI/UX-прототип мессенджера с голосовыми каналами (собственная визуальная идентичность)",
  "main": "src/main/main.js",
  "author": "Voice Nexus",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:win:publish": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.voicenexus.app",
    "productName": "Voice Nexus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "VoiceNexus-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "Shotohah",
      "repo": "Voice-Nexus"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11"
  }
}
